{
  "name": "void-scraper",
  "version": "1.0.0",
  "description": "A premium, dynamic web scraper application built with Electron.",
  "main": "main.js",
  "scripts": {
    "start": "node_modules/electron/dist/electron .",
    "build": "electron-builder --win",
    "build:portable": "electron-builder --win portable",
    "build:linux": "electron-builder --linux",
    "build:linux-appimage": "electron-builder --linux AppImage",
    "build:linux-deb": "electron-builder --linux deb",
    "build:linux-snap": "electron-builder --linux snap"
  },
  "keywords": [
    "electron",
    "scraper",
    "dynamic",
    "glassmorphism"
  ],
  "author": "Antigravity",
  "license": "ISC",
  "build": {
    "appId": "com.void.streamer",
    "productName": "Void Streamer",
    "icon": "icon.png",
    "files": [
      "main.js",
      "preload.js",
      "scraper.js",
      "index.html",
      "style.css",
      "renderer.js",
      "icon.png",
      "25.gif"
    ],
    "win": {
      "icon": "icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "linux": {
      "icon": "icon.png",
      "category": "AudioVideo",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "dependencies": {
    "axios": "^1.21.0",
    "cheerio": "^1.2.0"
  },
  "devDependencies": {
    "electron": "^43.3.0",
    "electron-builder": "^26.5.0"
  }
}
